<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- For the "workout going on" indicator on the watch face -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The rest timer is an alarm: it must go off on time while the watch sleeps (granted at install for timer apps) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Heart rate during a workout: its own permission from Wear OS 6, the body sensors one before that -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.BODY_SENSORS" android:maxSdkVersion="35" />
    <!-- The recording runs in a foreground service, so it goes on while the screen is off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The watch app works on its own: it does not need the phone app installed -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".RestAlarmReceiver" android:exported="false" />
        <service android:name=".HeartRateService" android:exported="false" android:foregroundServiceType="health" />
    </application>
</manifest>
